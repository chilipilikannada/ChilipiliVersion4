rules_version = '2';

// Photos and recordings. Families only reach their own children's files.
// These rules read Firestore, so allow Storage to read Firestore when the console asks.

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function email() { return request.auth.token.get('email', '').lower(); }
    function admin() {
      return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    // A teacher or guide the admin added (staff/{email}), active.
    function teacher() {
      return signedIn() && email() != ''
        && firestore.exists(/databases/(default)/documents/staff/$(email()))
        && firestore.get(/databases/(default)/documents/staff/$(email())).data.get('active', true) == true;
    }
    // The admin, or the teacher of this child's class.
    function staffFor(cid) {
      return admin() || (teacher()
        && firestore.get(/databases/(default)/documents/children/$(cid)).data.get('classId', '') != ''
        && firestore.get(/databases/(default)/documents/children/$(cid)).data.get('classId', '') in firestore.get(/databases/(default)/documents/staff/$(email())).data.get('classes', []));
    }
    function parentOf(cid) {
      return signedIn()
        && ((request.auth.token.get('kid', '') == cid)
            || request.auth.token.get('email', '').lower() in firestore.get(/databases/(default)/documents/children/$(cid)).data.parentEmails);
    }
    function media(mb) {
      return request.resource.size < mb * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('audio/.*')
            || request.resource.contentType == 'application/pdf');
    }

    // Packet photos, speaking recordings, voice notes in messages
    match /handins/{cid}/{file}  { allow read: if staffFor(cid) || parentOf(cid); allow create: if (staffFor(cid) || parentOf(cid)) && media(20); }
    match /speaking/{cid}/{file} { allow read: if staffFor(cid) || parentOf(cid); allow create: if (staffFor(cid) || parentOf(cid)) && media(20); }
    match /messages/{cid}/{file} { allow read: if staffFor(cid) || parentOf(cid); allow create: if (staffFor(cid) || parentOf(cid)) && media(20); }
    // The teacher's replies
    match /feedback/{cid}/{file} { allow read: if staffFor(cid) || parentOf(cid); allow create: if staffFor(cid) && media(20); }
    // Class feed photos and the teacher's word recordings
    match /posts/{file} { allow read: if signedIn(); allow write: if (admin() || teacher()) && media(10); }
    match /voice/{file} { allow read: if signedIn(); allow write: if admin() && media(5); }
    // The teacher's own worksheets (PDFs or images) for packet weeks
    match /packets/{file} { allow read: if signedIn(); allow write: if admin() && media(20); }
  }
}
